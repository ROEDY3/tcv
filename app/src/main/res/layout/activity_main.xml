<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TCV Camera — perekam video untuk Termux"
        android:textSize="18sp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Langkah 1: beri izin."
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btn_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Beri izin (kamera + mikrofon + notif)" />

    <Button
        android:id="@+id/btn_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Aktifkan layanan" />

    <Button
        android:id="@+id/btn_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Matikan optimasi baterai (disarankan)" />

    <Button
        android:id="@+id/btn_allfiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Beri akses semua file (untuk status)" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:text="Langkah 4: dari Termux jalankan: camvideo -d -l 5 -f ujicoba.mp4" />

</LinearLayout>
