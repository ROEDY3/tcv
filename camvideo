#!/bin/bash
# camvideo — rekam video kamera HP lewat aplikasi pendamping com.tcv.
#
# Cara pakai mirip termux-camera-video:
#   camvideo -h
#   camvideo -d -l 5 -f ujicoba.mp4
#   camvideo -i
#   camvideo -q
#
# Syarat: aplikasi com.tcv terinstal + izin kamera, mikrofon, penyimpanan
# sudah diberikan lewat aplikasinya (buka sekali dari launcher).

set -e

SCRIPTNAME=camvideo
RECEIVER="com.tcv/.CamVideoReceiver"
STATUS_FILE="/storage/emulated/0/Movies/.tcv_status.json"

show_usage () {
    echo "Usage: $SCRIPTNAME [args]"
    echo "Record video using a camera on your device (via com.tcv app)"
    echo
    echo "-h           Shows this help"
    echo "-d           Start recording w/ defaults"
    echo "-f <file>    Start recording to specific file (saved in Movies, must end in .mp4)"
    echo "-c <id>      Start recording using specified camera id"
    echo "-l <limit>   Start recording w/ specified duration limit (in seconds, unlimited for 0)"
    echo "-b <bitrate> Start recording w/ specified video bitrate (in kbps)"
    echo "-r <fps>     Start recording w/ specified frame rate"
    echo "-n           Start recording w/o audio"
    echo "-i           Get info about current recording"
    echo "-q           Quits recording"
}

usage_error () {
    echo
    show_usage
    exit 1
}

sole() {
    if [ "$1 $2" != "-$option $OPTARG" ] || [ $# -gt 2 ]; then
        echo "ERROR: No other options should be specified with -$option!"
        usage_error
    fi
}

add_params() {
    for i in "$@"; do
        params[index++]="$i"
    done
}

call_api () {
    am broadcast -n "$RECEIVER" "$@"
}

show_status () {
    # beri waktu service menulis status
    sleep 2
    if [ -f "$STATUS_FILE" ]; then
        cat "$STATUS_FILE"
        echo
    else
        echo "(tidak ada file status — aplikasi com.tcv mungkin belum terinstal / izin belum lengkap)"
    fi
}

while getopts h,f:,c:,l:,b:,r:,n,d,i,q option
do
    case "$option" in
        h) sole "$@"
           ;;
        f) record=yes
           add_params --es file "$OPTARG"
           ;;
        c) record=yes
           add_params --es camera "$OPTARG"
           ;;
        # API takes limit in milliseconds
        l) record=yes
           add_params --ei limit $((OPTARG * 1000))
           ;;
        # API takes bitrate in bps
        b) record=yes
           add_params --ei bitrate $((OPTARG * 1000))
           ;;
        r) record=yes
           add_params --ei fps $((OPTARG))
           ;;
        n) record=yes
           add_params --ez audio false
           ;;
        d) record=yes
           ;;
        i) sole "$@"
           add_params -a info
           ;;
        q) sole "$@"
           add_params -a quit
           ;;
        *) usage_error
           ;;
    esac
done

if [ -v record ]; then
    add_params -a record
fi

if [ -v params ]; then
    call_api "${params[@]}" > /dev/null
    show_status
else
    show_usage
fi
