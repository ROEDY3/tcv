#!/data/data/com.termux/files/usr/bin/bash
# camvideo — rekam video kamera HP lewat aplikasi pendamping com.tcv.
#
# Cara pakai mirip termux-camera-video:
#   camvideo -h
#   camvideo -d -l 5 -f ujicoba.mp4
#   camvideo -i
#   camvideo -q
#
# Syarat: aplikasi com.tcv terinstal + izin kamera, mikrofon, penyimpanan
# sudah diberikan lewat aplikasinya (buka sekali dari launcher).

set -e

SCRIPTNAME=camvideo
RECEIVER="com.tcv/.CamVideoReceiver"
STATUS_FILE="/storage/emulated/0/Download/tcv_status.json"

show_usage () {
    echo "Usage: $SCRIPTNAME [args]"
    echo "Record video using a camera on your device (via com.tcv app)"
    echo
    echo "-h           Shows this help"
    echo "-d           Start recording w/ defaults"
    echo "-f <file>    Start recording to specific file (saved in Movies, must end in .mp4)"
    echo "-c <id>      Start recording using specified camera id"
    echo "-l <limit>   Start recording w/ specified duration limit (in seconds, unlimited for 0)"
    echo "-b <bitrate> Start recording w/ specified video bitrate (in kbps)"
    echo "-p <fps>     Start recording w/ specified frame rate"
    echo "-n           Start recording w/o audio"
    echo "-s           Start stream (Python TCP + OBS http://127.0.0.1:8091/mjpeg + mic /audio.wav; boleh + -c <id> + -r <preset>)"
    echo "-r <preset>  Stream resolution preset (only with -s): 4:3|1:1|16:9|hd|9:16|fhd (default 4:3)"
    echo "-S           Stop stream"
    echo "-C           List cameras (id depan/belakang)"
    echo "-i           Get info about current recording"
    echo "-q           Quits recording"
}

usage_error () {
    echo
    show_usage
    exit 1
}

sole() {
    if [ "$1 $2" != "-$option $OPTARG" ] || [ $# -gt 2 ]; then
        echo "ERROR: No other options should be specified with -$option!"
        usage_error
    fi
}

add_params() {
    for i in "$@"; do
        params[index++]="$i"
    done
}

call_api () {
    # --receiver-foreground: beri prioritas foreground agar sistem membangunkan
    # aplikasi + mengizinkan start service dari background.
    am broadcast --receiver-foreground -n "$RECEIVER" "$@"
}

add_stream_ratio () {
    # Petakan preset rasio ke ukuran yang diminta; aplikasi menyesuaikan
    # ke ukuran JPEG yang benar-benar didukung kamera.
    case "$1" in
        4:3)      add_params --ei sw 640  --ei sh 480 ;;
        1:1)      add_params --ei sw 640  --ei sh 640 ;;
        16:9|hd)  add_params --ei sw 1280 --ei sh 720 ;;
        9:16)     add_params --ei sw 720  --ei sh 1280 ;;
        fhd)      add_params --ei sw 1920 --ei sh 1080 ;;
        *)
            echo "ERROR: preset rasio '$1' tidak dikenal (pakai: 4:3|1:1|16:9|hd|9:16|fhd)!"
            usage_error
            ;;
    esac
}

show_status () {
    # beri waktu service menulis status
    sleep 2
    if [ -f "$STATUS_FILE" ]; then
        cat "$STATUS_FILE"
        echo
    else
        echo "(tidak ada file status — aplikasi com.tcv mungkin belum terinstal / izin belum lengkap)"
    fi
}

while getopts h,f:,c:,l:,b:,p:,r:,n,d,i,q,s,S,C option
do
    case "$option" in
        h) sole "$@"
           ;;
        f) record=yes
           recopt=yes
           add_params --es file "$OPTARG"
           ;;
        c) cam=yes
           add_params --es camera "$OPTARG"
           ;;
        # API takes limit in milliseconds
        l) record=yes
           recopt=yes
           add_params --ei limit $((OPTARG * 1000))
           ;;
        # API takes bitrate in bps
        b) record=yes
           recopt=yes
           add_params --ei bitrate $((OPTARG * 1000))
           ;;
        p) record=yes
           recopt=yes
           add_params --ei fps $((OPTARG))
           ;;
        r) ratio="$OPTARG"
           ratioopt=yes
           ;;
        n) record=yes
           recopt=yes
           add_params --ez audio false
           ;;
        d) record=yes
           ;;
        s) stream=yes
           add_params -a stream_start
           ;;
        S) sstop=yes
           sole "$@"
           add_params -a stream_stop
           ;;
        C) cams=yes
           sole "$@"
           add_params -a cameras
           ;;
        i) info=yes
           sole "$@"
           add_params -a info
           ;;
        q) quit=yes
           sole "$@"
           add_params -a quit
           ;;
        *) usage_error
           ;;
    esac
done

if [ -v stream ]; then
    # Mode stream: hanya boleh ditemani -c (pilih kamera).
    if [ -v rec ] || [ -v info ] || [ -v quit ] || [ -v sstop ] || [ -v cams ]; then
        echo "ERROR: -s tidak bisa digabung perintah lain (-d/-i/-q/-S/-C)!"
        usage_error
    fi
    if [ -v recopt ]; then
        echo "ERROR: -f/-l/-b/-p/-n hanya untuk merekam, bukan stream!"
        usage_error
    fi
    if [ -v ratio ]; then
        add_stream_ratio "$ratio"
    fi
else
    if [ -v ratio ]; then
        echo "ERROR: -r (preset rasio) hanya untuk stream, pakai bersama -s!"
        usage_error
    fi
    ncmd=0
    [ -v rec ] && ncmd=$((ncmd + 1))
    [ -v info ] && ncmd=$((ncmd + 1))
    [ -v quit ] && ncmd=$((ncmd + 1))
    [ -v sstop ] && ncmd=$((ncmd + 1))
    [ -v cams ] && ncmd=$((ncmd + 1))
    if [ "$ncmd" -gt 1 ]; then
        echo "ERROR: satu perintah saja dalam sekali jalan!"
        usage_error
    fi
    # -c sendirian = rekam default di kamera itu (perilaku lama).
    if [ -v cam ] && [ "$ncmd" -eq 0 ]; then
        record=yes
    fi
fi

if [ -v record ]; then
    add_params -a record
fi

if [ -v params ]; then
    call_api "${params[@]}" > /dev/null
    show_status
else
    show_usage
fi
